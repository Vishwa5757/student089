# Smart Student Reminder System - Environment Configuration Example
# Copy this file to .env and fill in your environment specific values.

# Flask Application Settings
SECRET_KEY=smart-student-reminder-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=smart_student_reminder

# Automated Reminder Scheduler Settings
REMINDER_INTERVAL_MINUTES=1
REMINDER_ENABLED=True
